# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# CI installs with pip; a uv-generated lockfile isn't honored there and
# would give false confidence about pinning.
uv.lock

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store

# Environment and local state
.env
state/

# Personal, project-scoped Claude Code settings (permission allowlists, etc.)
.claude/settings.local.json
